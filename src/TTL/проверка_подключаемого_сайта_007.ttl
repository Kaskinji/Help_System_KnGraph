@prefix comcore: <https://kb.moneta.ru/terms/common/coreontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix : <https://kb.moneta.ru/terms/TurnOnSup/offer/> .

:задача_MRM rdf:type comcore:Process ;
  rdfs:label "Задача MRM"@ru ;
  comcore:hasResult :статус_Закрыт_Отказано .

:статус_Закрыт_Отказано rdf:type comcore:Event ;
  rdfs:label "Статус «Закрыт. Отказано»"@ru ;
  comcore:Initiates :ознакомиться_с_комментариями_ОБР .

:сотрудник_отдела_сопровождения rdf:type comcore:Agent ;
  rdfs:label "Сотрудник отдела сопровождения"@ru ;
  comcore:isActorOf :ознакомиться_с_комментариями_ОБР .

:сотрудник_ОБР rdf:type comcore:Agent ;
  rdfs:label "Сотрудник ОБР"@ru ;
  comcore:isResponsibleFor :комментарии_сотрудника_ОБР .

:комментарии_сотрудника_ОБР rdf:type comcore:Resource ;
  rdfs:label "Комментарии сотрудника ОБР"@ru ;
  comcore:isResourceOf :ознакомиться_с_комментариями_ОБР .

:ознакомиться_с_комментариями_ОБР rdf:type comcore:Process ;
  rdfs:label "Ознакомиться с комментариями сотрудника ОБР"@ru .