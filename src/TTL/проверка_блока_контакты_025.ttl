@prefix comcore: <https://kb.moneta.ru/terms/common/coreontology#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcmtype: <http://purl.org/dc/dcmitype/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <https://kb.moneta.ru/terms/TurnOnSup/offer/> .

:Клиент rdf:type comcore:Agent ;
  rdfs:label "Клиент"@ru ;
  comcore:Initiates :корректировка_почтового_адреса ;
  comcore:isActorOf :корректировка_почтового_адреса , :отправка_на_проверку .

:личный_кабинет rdf:type comcore:Resource ;
  rdfs:label "Личный кабинет"@ru ;
  comcore:isResourceOf :корректировка_почтового_адреса , :отправка_на_проверку .

:корректировка_почтового_адреса rdf:type comcore:Process ;
  rdfs:label "Корректировка почтового адреса"@ru ;
  comcore:isPartOf :отправка_на_проверку .

:почтовый_адрес rdf:type comcore:Resource ;
  rdfs:label "Почтовый адрес"@ru ;
  comcore:isResourceOf :корректировка_почтового_адреса ;
  comcore:canBeResourceFor :подключение_платежного_сервиса .

:поле_почтового_адреса rdf:type comcore:Resource ;
  rdfs:label "Поле почтового адреса"@ru ;
  comcore:isResourceOf :проверка_скорректированных_данных .

:отправка_на_проверку rdf:type comcore:Process ;
  rdfs:label "Отправка на проверку"@ru ;
  comcore:isPartOf :проверка_скорректированных_данных .

:информационное_письмо_OTRS rdf:type comcore:Resource ;
  rdfs:label "Информационное письмо в OTRS"@ru ;
  comcore:isResourceOf :приход_информационного_письма_в_OTRS .

:приход_информационного_письма_в_OTRS rdf:type comcore:Event ;
  rdfs:label "Приход информационного письма в OTRS"@ru ;
  comcore:Initiates :проверка_скорректированных_данных .

:OTRS rdf:type comcore:Agent ;
  rdfs:label "OTRS"@ru .

:проверка_скорректированных_данных rdf:type comcore:Process ;
  rdfs:label "Проверка скорректированных данных"@ru ;
  comcore:isActorOf :Сотрудник ;
  comcore:hasResult :формат_адреса_неполный .

:Сотрудник rdf:type comcore:Agent ;
  rdfs:label "Сотрудник"@ru ;
  comcore:isActorOf :проверка_скорректированных_данных , :связаться_с_клиентом_по_контактному_телефону .

:формат_адреса_неполный rdf:type comcore:Event ;
  rdfs:label "Формат предоставленного адреса неполный"@ru .

:Сотрудник_отдела_сопровождения rdf:type comcore:Agent ;
  rdfs:label "Сотрудник отдела сопровождения"@ru ;
  comcore:isActorOf :присвоение_статусов_чекбоксам ;
  comcore:isResponsibleFor :чекбоксы .

:чекбоксы rdf:type comcore:Resource ;
  rdfs:label "Чекбоксы"@ru ;
  comcore:isResourceOf :присвоение_статусов_чекбоксам .

:присвоение_статусов_чекбоксам rdf:type comcore:Process ;
  rdfs:label "Присвоение статусов чекбоксам"@ru ;
  comcore:hasResult :статус_Подтвержденное .

:статус_Подтвержденное rdf:type comcore:Event ;
  rdfs:label "Статус «Подтвержденное»"@ru .

:отсутствие_корректировок_после_письма rdf:type comcore:Event ;
  rdfs:label "Клиент не внес необходимые корректировки после отправки информационного письма"@ru ;
  comcore:Initiates :связаться_с_клиентом_по_контактному_телефону .

:связаться_с_клиентом_по_контактному_телефону rdf:type comcore:Process ;
  rdfs:label "Связаться с клиентом по контактному телефону"@ru .

:контактный_телефон rdf:type comcore:Resource ;
  rdfs:label "Контактный телефон"@ru ;
  comcore:isResourceOf :связаться_с_клиентом_по_контактному_телефону .

:шаблон_разговора rdf:type comcore:Resource ;
  rdfs:label "Шаблон разговора"@ru ;
  comcore:canBeResourceFor :связаться_с_клиентом_по_контактному_телефону .

:разговор_с_клиентом rdf:type comcore:Process ;
  rdfs:label "Разговор с Клиентом"@ru ;
  comcore:isPartOf :связаться_с_клиентом_по_контактному_телефону ;
  comcore:isActorOf :Сотрудник .

:PayAnyWay_НКО_Монета rdf:type comcore:Agent ;
  rdfs:label "PayAnyWay НКО Монета"@ru ;
  comcore:isResponsibleFor :подключение_платежного_сервиса .

:подключение_платежного_сервиса rdf:type comcore:Process ;
  rdfs:label "Подключение платежного сервиса"@ru .

:паспортные_данные_ФИО rdf:type comcore:Resource ;
  rdfs:label "Паспортные данные ФИО"@ru ;
  comcore:canBeResourceFor :подключение_платежного_сервиса .

:ФИО_в_личном_кабинете rdf:type comcore:Resource ;
  rdfs:label "ФИО, указанные в личном кабинете"@ru ;
  comcore:isResourceOf :проверка_скорректированных_данных .

:ООО_ИП_______ rdf:type comcore:Agent ;
  rdfs:label "ООО/ИП _______"@ru ;
  comcore:isPartOf :личный_кабинет .