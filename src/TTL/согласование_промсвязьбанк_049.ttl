@prefix comcore: <https://kb.moneta.ru/terms/common/coreontology#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcmtype: <http://purl.org/dc/dcmitype/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <https://kb.moneta.ru/terms/TurnOnSup/offer/> .

:Мой_счет rdf:type comcore:Resource ;
  rdfs:label "Мой счет"@ru .

:Управление_счетами rdf:type comcore:Process ;
  rdfs:label "Управление счетами"@ru ;
  comcore:isPartOf :Мой_счет .

:Согласования rdf:type comcore:Process ;
  rdfs:label "Согласования"@ru ;
  comcore:isPartOf :Управление_счетами ;
  comcore:hasResult :положительное_согласование .

:Промсвязьбанк rdf:type comcore:Agent , comcore:Resource ;
  rdfs:label "Промсвязьбанк"@ru ;
  comcore:isActorOf :Согласования .

:ПСБ rdf:type comcore:Agent ;
  rdfs:label "ПСБ"@ru ;
  comcore:isActorOf :Согласования .

:Добавить rdf:type comcore:Process ;
  rdfs:label "Добавить"@ru ;
  comcore:isPartOf :Промсвязьбанк .

:Отправить rdf:type comcore:Process ;
  rdfs:label "Отправить"@ru ;
  comcore:isPartOf :Добавить .

:положительное_согласование rdf:type comcore:Event ;
  rdfs:label "положительное согласование"@ru ;
  comcore:Initiates :внесение_данных_терминала .

:автоматический_обработчик rdf:type comcore:Agent ;
  rdfs:label "автоматический обработчик"@ru ;
  comcore:Initiates :внесение_данных_терминала ;
  comcore:isResponsibleFor :внесение_данных_терминала , :поле_Дополнительные_параметры_интерфейса , :данные_терминала ;
  comcore:isActorOf :внесение_данных_терминала .

:внесение_данных_терминала rdf:type comcore:Process ;
  rdfs:label "внесение данных терминала"@ru ;
  comcore:hasResult :данные_терминала ;
  comcore:isPartOf :Управление_счетами ;
  comcore:isActorOf :автоматический_обработчик .

:поле_Дополнительные_параметры_интерфейса rdf:type comcore:Resource ;
  rdfs:label "Дополнительные параметры интерфейса"@ru ;
  comcore:isPartOf :Управление_счетами ;
  comcore:isResourceOf :внесение_данных_терминала .

:данные_терминала rdf:type comcore:Resource ;
  rdfs:label "данные терминала"@ru ;
  comcore:isResourceOf :внесение_данных_терминала .