:обработка_обращения_потенциального_клиента rdf:type comcore:Process ;
    rdfs:label "Обработка обращения потенциального Клиента"@ru ;
    comcore:hasSubProcess :регистрация_получателя ;
    comcore:hasSubProcess :проверка_готовности_функционала_сайта ;
    comcore:hasSubProcess :заполнение_личного_кабинета ;
    comcore:hasSubProcess :создание_бизнес_счета .

:регистрация_получателя rdf:type comcore:Process ;
    rdfs:label "Регистрация получателя"@ru ;
    comcore:isPartOf :обработка_обращения_потенциального_клиента ;
    comcore:isResultOf :подключение_к_системе .

:проверка_готовности_функционала_сайта rdf:type comcore:Process ;
    rdfs:label "Проверка готовности функционала сайта"@ru ;
    comcore:isPartOf :обработка_обращения_потенциального_клиента ;
    comcore:isResultOf :регистрация_получателя .

:заполнение_личного_кабинета rdf:type comcore:Process ;
    rdfs:label "Заполнение личного кабинета"@ru ;
    comcore:isPartOf :обработка_обращения_потенциального_клиента ;
    comcore:isResultOf :проверка_готовности_функционала_сайта .

:создание_бизнес_счета rdf:type comcore:Process ;
    rdfs:label "Создание бизнес-счета"@ru ;
    comcore:isPartOf :обработка_обращения_потенциального_клиента ;
    comcore:isResultOf :заполнение_личного_кабинета .

:клиент rdf:type comcore:Agent ;
    rdfs:label "Клиент"@ru ;
    comcore:isActorOf :обработка_обращения_потенциального_клиента ;
    comcore:isResponsibleFor :заполнение_личного_кабинета .

:руководитель_отдела_по_работе_с_им rdf:type comcore:Agent ;
    rdfs:label "Руководитель отдела по работе с ИМ"@ru ;
    comcore:isActorOf :обработка_обращения_потенциального_клиента ;
    comcore:isResponsibleFor :создание_бизнес_счета .

:получатель rdf:type comcore:Resource ;
    rdfs:label "Получатель"@ru ;
    comcore:isResourceOf :регистрация_получателя ;
    comcore:canBeResourceFor :создание_бизнес_счета .

:система_монета rdf:type comcore:Resource ;
    rdfs:label "Система МОНЕТА"@ru ;
    comcore:isResourceOf :обработка_обращения_потенциального_клиента ;
    comcore:canBeResourceFor :создание_бизнес_счета .

:подключение_к_системе rdf:type comcore:Event ;
    rdfs:label "Подключение к системе"@ru ;
    comcore:isResultOf :обработка_обращения_потенциального_клиента ;
    comcore:Initiates :создание_бизнес_счета .
