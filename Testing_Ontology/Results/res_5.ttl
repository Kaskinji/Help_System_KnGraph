:сопровождение rdf:type comcore:Process ;
    rdfs:label "Сопровождение"@ru ;
    comcore:hasSubProcess :анализ_комментария ;
    comcore:hasSubProcess :проверка_заполнения_личного_кабинета .

:анализ_комментария rdf:type comcore:Process ;
    rdfs:label "Анализ комментария"@ru ;
    comcore:isPartOf :сопровождение ;
    comcore:isResultOf :отказано .

:проверка_заполнения_личного_кабинета rdf:type comcore:Process ;
    rdfs:label "Проверка заполнения личного кабинета"@ru ;
    comcore:isPartOf :сопровождение ;
    comcore:isResultOf :согласовано .

:отказано rdf:type comcore:Event ;
    rdfs:label "Отказано"@ru ;
    comcore:Initiates :анализ_комментария ;
    comcore:isResultOf :сопровождение .

:согласовано rdf:type comcore:Event ;
    rdfs:label "Согласовано"@ru ;
    comcore:Initiates :проверка_заполнения_личного_кабинета ;
    comcore:isResultOf :сопровождение .

:открытый rdf:type comcore:Event ;
    rdfs:label "Открытый"@ru ;
    comcore:Initiates :анализ_комментария ;
    comcore:isResultOf :сопровождение .

:сотрудник_отдела_сопровождения rdf:type comcore:Agent ;
    rdfs:label "Сотрудник отдела сопровождения"@ru ;
    comcore:isActorOf :сопровождение ;
    comcore:isResponsibleFor :анализ_комментария .

:сотрудник_обр rdf:type comcore:Agent ;
    rdfs:label "Сотрудник ОБР"@ru ;
    comcore:isActorOf :сопровождение ;
    comcore:isResponsibleFor :отказано .

:комментарий rdf:type comcore:Resource ;
    rdfs:label "Комментарий"@ru ;
    comcore:isResourceOf :анализ_комментария ;
    comcore:canBeResourceFor :сопровождение .

:личный_кабинет rdf:type comcore:Resource ;
    rdfs:label "Личный кабинет"@ru ;
    comcore:isResourceOf :проверка_заполнения_личного_кабинета ;
    comcore:canBeResourceFor :сопровождение .
```

