meta-llama/llama-3.3-70b-instruct:free

:обработка_обращения_потенциального_клиента rdf:type comcore:Process ;
  rdfs:label "Обработка обращения потенциального клиента"@ru ;
  comcore:hasResult :регистрация_клиента ;
  comcore:isPartOf :бизнес_процесс ;
  dc:description """Обработка обращения потенциального клиента""" .

:регистрация_клиента rdf:type comcore:Resource ;
  rdfs:label "Регистрация клиента"@ru ;
  comcore:isResourceOf :обработка_обращения_потенциального_клиента ;
  comcore:canBeResourceFor :подключение_к_системе .

:подключение_к_системе rdf:type comcore:Process ;
  rdfs:label "Подключение к системе"@ru ;
  comcore:hasResult :бизнес_счет ;
  comcore:isPartOf :обработка_обращения_потенциального_клиента ;
  dc:description """Подключение к системе""" .

:бизнес_счет rdf:type comcore:Resource ;
  rdfs:label "Бизнес счет"@ru ;
  comcore:isResourceOf :подключение_к_системе ;
  comcore:canBeResourceFor :оплата_услуг .

:клиент rdf:type comcore:Agent ;
  rdfs:label "Клиент"@ru ;
  comcore:isActorOf :обработка_обращения_потенциального_клиента ;
  comcore:isResponsibleFor :регистрация_клиента .

:руководитель_отдела_по_работе_с_им rdf:type comcore:Agent ;
  rdfs:label "Руководитель отдела по работе с ИМ"@ru ;
  comcore:isActorOf :обработка_обращения_потенциального_клиента ;
  comcore:isResponsibleFor :подключение_к_системе .

:получатель rdf:type comcore:Agent ;
  rdfs:label "Получатель"@ru ;
  comcore:isActorOf :обработка_обращения_потенциального_клиента ;
  comcore:isResponsibleFor :регистрация_клиента .

:торговая_площадка rdf:type comcore:Agent ;
  rdfs:label "Торгов!_31atica площадка"@ru ;
  comcore:isActorOf :обработка_обращения_потенциального_клиента ;
  comcore:isResponsibleFor :оплата_услуг .


Не извлеченные Агенты:

# Отсутствуют в выводе:
:по_ас_монета a comcore:System ;
  rdfs:label "ПО АС МОНЕТА"@ru .

:сотрудник_отдела_по_работе_с_клиентами a comcore:Employee ;
  rdfs:label "Сотрудник отдела по работе с клиентами"@ru .

:отдел_обр a comcore:Agent ;
  rdfs:label "Отдел ОБР"@ru .

  Не извлеченные Процессы:
  # Основной процесс не выделен:
:обработка_обращения_потенциального_клиента a comcore:Process ;
  rdfs:label "Обработка обращения потенциального клиента"@ru .

# Подпроцессы не извлечены:
:проверка_готовности_функционала a comcore:Process ;
  rdfs:label "Проверка готовности функционала сайта"@ru .

:проверка_легитимности a comcore:Process ;
  rdfs:label "Проверка легитимности товаров и услуг"@ru .

:заполнение_личного_кабинета a comcore:Process ;
  rdfs:label "Заполнение личного кабинета"@ru .

:создание_бизнес_счета a comcore:Process ;
  rdfs:label "Создание бизнес-счета"@ru .

  Не извлеченные Ресурсы:
  :личный_кабинет a comcore:Resource ;
  rdfs:label "Личный кабинет"@ru .

:функционал_сайта a comcore:Resource ;
  rdfs:label "Функционал сайта"@ru .

:товары_и_услуги a comcore:Resource ;
  rdfs:label "Товары и услуги"@ru .

:данные_о_получателе a comcore:Resource ;
  rdfs:label "Данные о получателе"@ru .